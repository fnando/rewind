<% totals = @stats[:totals] %>
<% head = @stats[:headline] %>
<% movies = totals[:movies_count] %>
<% episodes = totals[:episodes_count] %>
<% split_total = movies + episodes %>
<% movie_pct = split_total.positive? ? (movies.to_f / split_total * 100) : 0 %>
<section class="hero-stat panel">
  <div class="hero-stat__body">
    <span class="hero-stat__eyebrow">Your <%= h(head[:period_label]) %> so far</span>
    <div class="hero-stat__count">
      <span class="hero-stat__big"><%= head[:big_number] %></span>
      <span class="hero-stat__suffix"><%= head[:big_number] == 1 ? "thing" : "things" %> watched</span>
    </div>
    <p class="hero-stat__sentence"><%= h(head[:hours_sentence]) %></p>
  </div>
  <% if split_total.positive? %>
    <div class="hero-stat__donut-wrap">
      <%
        single_color = movies.zero? || episodes.zero?
        gap = single_color ? 0 : 1.5
        half_gap = gap / 2.0
        movies_len = movies.zero? ? 0 : (episodes.zero? ? 100 : [movie_pct - gap, 0].max)
        tv_len = episodes.zero? ? 0 : (movies.zero? ? 100 : [100 - movie_pct - gap, 0].max)
      %>
      <svg class="donut" viewBox="0 0 42 42" role="img" aria-label="<%= movie_pct.round %>% movies, <%= (100 - movie_pct).round %>% episodes">
        <g transform="rotate(-90 21 21)">
          <circle class="donut__seg donut__seg--movies" cx="21" cy="21" r="15.9155"
                  pathLength="100"
                  stroke-dasharray="<%= movies_len %> <%= 100 - movies_len %>"
                  stroke-dashoffset="<%= -half_gap %>"></circle>
          <circle class="donut__seg donut__seg--tv" cx="21" cy="21" r="15.9155"
                  pathLength="100"
                  stroke-dasharray="<%= tv_len %> <%= 100 - tv_len %>"
                  stroke-dashoffset="<%= -movie_pct - half_gap %>"></circle>
        </g>
      </svg>
      <ul class="donut-legend">
        <li><span class="donut-legend__swatch donut-legend__swatch--movies"></span>
          <span class="donut-legend__count"><%= pluralize(movies, "movie") %></span>
          <span class="donut-legend__pct"><%= movie_pct.round %>%</span>
        </li>
        <li><span class="donut-legend__swatch donut-legend__swatch--tv"></span>
          <span class="donut-legend__count"><%= pluralize(episodes, "episode") %></span>
          <span class="donut-legend__pct"><%= (100 - movie_pct).round %>%</span>
        </li>
      </ul>
    </div>
  <% end %>
</section>
