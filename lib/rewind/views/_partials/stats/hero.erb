<% totals = @stats[:totals] %>
<% head = @stats[:headline] %>
<%
  segments = [
    {cls: "movies", noun: "movie", count: totals[:movies_count], hours: totals[:movies_hours]},
    {cls: "tv", noun: "episode", count: totals[:episodes_count], hours: totals[:episodes_hours]},
    {cls: "music", noun: "track", count: totals[:tracks_count].to_i, hours: totals[:listening_hours]}
  ].select {|s| s[:count].positive? }
  split_total = segments.sum {|s| s[:count] }
  # Weigh the donut by time spent, not play counts (a movie dwarfs a song);
  # fall back to counts when no runtimes are known.
  total_hours = segments.sum {|s| s[:hours].to_f }
  weigh = ->(s) { total_hours.positive? ? s[:hours].to_f : s[:count] }
  total_weight = segments.sum {|s| weigh.call(s) }
  gap = segments.size > 1 ? 1.5 : 0
  cursor = 0.0
  segments.each do |s|
    s[:pct] = total_weight.positive? ? (weigh.call(s) / total_weight * 100) : 0
    s[:len] = [s[:pct] - gap, 0].max
    s[:offset] = cursor
    cursor += s[:pct]
  end
%>
<section class="hero-stat panel">
  <div class="hero-stat__body">
    <span class="hero-stat__eyebrow">Your <%= h(head[:period_label]) %> so far</span>
    <div class="hero-stat__count">
      <span class="hero-stat__big"><%= head[:big_number] %></span>
      <span class="hero-stat__suffix"><%= h(head[:unit]) %></span>
    </div>
    <p class="hero-stat__sentence"><%= h(head[:hours_sentence]) %></p>
  </div>
  <% if split_total.positive? %>
    <div class="hero-stat__donut-wrap">
      <svg class="donut" viewBox="0 0 42 42" role="img" aria-label="<%= segments.map {|s| "#{s[:pct].round}% #{s[:noun]}s" }.join(", ") %>">
        <g transform="rotate(-90 21 21)">
          <% segments.each do |s| %>
            <circle class="donut__seg donut__seg--<%= s[:cls] %>" cx="21" cy="21" r="15.9155"
                    pathLength="100"
                    stroke-dasharray="<%= s[:len].round(2) %> <%= (100 - s[:len]).round(2) %>"
                    stroke-dashoffset="<%= (-s[:offset] - gap / 2.0).round(2) %>"></circle>
          <% end %>
        </g>
      </svg>
      <ul class="donut-legend">
        <% segments.each do |s| %>
          <li><span class="donut-legend__swatch donut-legend__swatch--<%= s[:cls] %>"></span>
            <span class="donut-legend__count"><%= pluralize(s[:count], s[:noun]) %></span>
            <span class="donut-legend__pct"><%= s[:pct].round %>%</span>
          </li>
        <% end %>
      </ul>
    </div>
  <% end %>
</section>
