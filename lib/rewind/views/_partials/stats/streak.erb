<%
  # The active media filter picks which scope to show; "all" is the overall one.
  scope =
    if @media_type == "all"
      @streaks[:overall]
    else
      @streaks[:by_media_group][@media_type]
    end

  current = scope[:current]
  longest = scope[:longest]
  state =
    if longest.nil? then :empty
    elsif scope[:is_record] then :record
    elsif current.positive? then :active
    else :ended
    end

  card_class =
    case state
    when :record then " streak-card--record"
    when :ended, :empty then " streak-card--idle"
    else ""
    end

  phrase =
    case @media_type
    when "movie" then "watched a movie"
    when "series" then "watched a show"
    when "music" then "listened to music"
    else "watched something"
    end

  fmt_range = lambda do |s, e|
    sd = Date.parse(s)
    ed = Date.parse(e)
    if sd == ed
      sd.strftime("%b %-d, %Y")
    elsif sd.year == ed.year && sd.month == ed.month
      "#{sd.strftime('%b %-d')}–#{ed.strftime('%-d, %Y')}"
    elsif sd.year == ed.year
      "#{sd.strftime('%b %-d')} – #{ed.strftime('%b %-d, %Y')}"
    else
      "#{sd.strftime('%b %-d, %Y')} – #{ed.strftime('%b %-d, %Y')}"
    end
  end

  flame_svg = '<svg viewBox="0 0 24 24" stroke-width="1.8" stroke-linejoin="round" aria-hidden="true"><path d="M12 2.5c.6 3.2 4.8 5.6 4.8 10.4A4.8 4.8 0 0 1 12 17.7a4.8 4.8 0 0 1-4.8-4.8c0-1.9.9-3.3 1.9-4.4.2 1.5 1 2.6 2.1 3 0-3.5.5-6.4.8-9z"/><path class="stroke-only" d="M12 21.5c-3.9 0-7-2.7-7-6.4" stroke-linecap="round"/><path class="stroke-only" d="M19 15.1c0 2.6-1.6 4.8-4 5.8" stroke-linecap="round"/></svg>'
  check_svg = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12l5 5 9-10"/></svg>'
  trophy_svg = '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8 21h8M12 17v4M7 4h10v5a5 5 0 0 1-10 0zM7 6H4a3 3 0 0 0 3 4M17 6h3a3 3 0 0 1-3 4"/></svg>'
%>
<section class="streak-card<%= card_class %>">
  <div class="streak-card__main">
    <div class="streak-card__summary">
      <span class="streak-card__icon" aria-hidden="true"><%= flame_svg %></span>
      <div class="streak-card__text">
        <div class="streak-card__head">
          <h2>Streak</h2>
          <% if state == :record %>
            <span class="streak-card__badge">New record</span>
          <% end %>
        </div>
        <p class="streak-card__count"><strong><%= current %></strong><span><%= pluralize(current, "day", count: false) %></span></p>
        <p class="streak-card__line">
          <% case state %>
          <% when :record %>
            <%= pluralize(current, "day") %> in a row: your longest streak ever. Keep it rolling.
          <% when :active %>
            You&#8217;ve <%= phrase %> <%= pluralize(current, "day") %> in a row. Nice!
          <% when :ended %>
            <%
              last = scope[:last_streak]
              was_record = last[:length] == longest[:length]
            %>
            Your <%= pluralize(last[:length], "day") %> streak ended on <%= Date.parse(last[:end]).strftime("%b %-d") %><%= ", and it was your best yet" if was_record %>. Watch something today to start a new one.
          <% else %>
            No streak yet. Every day you watch something adds a day to your streak.
          <% end %>
        </p>
      </div>
    </div>
    <div class="streak-strip">
      <div class="streak-strip__scroll">
        <ol aria-label="Last 14 days">
          <% scope[:strip].each do |cell| %>
            <%
              classes = ["streak-day"]
              classes << "is-streak" if cell[:in_streak]
              classes << "is-watched" if cell[:watched] && !cell[:in_streak]
              classes << "is-today" if cell[:today]
              classes << "is-pending" if cell[:today] && !cell[:watched]
              label = cell[:today] ? "Today" : cell[:date].strftime("%a")[0]
              title = cell[:date].strftime("%a, %b %-d") + (cell[:today] ? " (today)" : "")
            %>
            <li title="<%= title %>">
              <span class="<%= classes.join(' ') %>" role="img" aria-label="<%= title %>"><% if cell[:watched] %><%= check_svg %><% end %></span>
              <span class="streak-day__label<%= ' is-today' if cell[:today] %>" aria-hidden="true"><%= label %></span>
            </li>
          <% end %>
        </ol>
      </div>
      <div class="streak-legend" aria-hidden="true"><span><i class="is-streak"></i>Streak</span><span><i class="is-watched"></i>Watched</span><span><i class="is-today"></i>Today</span></div>
    </div>
  </div>

  <% if state == :empty %>
    <div class="streak-card__foot streak-card__foot--cta">
      <span>Watch something on two days in a row and the counter starts climbing.</span>
      <a class="btn btn--primary" href="/search">Log a watch</a>
    </div>
  <% else %>
    <%
      if state == :record && scope[:previous_best]
        best = scope[:previous_best]
        best_label = "Previous best:"
        gained = current - best[:length]
        progress_pct = 100
        progress_text =
          gained.positive? ? "#{pluralize(gained, 'day')} past your old record" : "You matched your best ever"
      elsif state == :record
        best = scope[:current_range].merge(length: current)
        best_label = "Longest streak:"
        progress_pct = 100
        progress_text = "Your longest streak yet"
      else
        best = longest
        best_label = "Longest streak:"
        progress_pct = state == :active ? [(current * 100.0 / longest[:length]).round, 100].min : 0
        progress_text =
          state == :active ? "#{pluralize(longest[:length] - current, 'day')} to beat it" : "Start again today to chase it"
      end
    %>
    <div class="streak-card__foot">
      <span class="streak-best"><%= trophy_svg %><span><%= best_label %> <strong><%= pluralize(best[:length], "day") %></strong> <small>· <%= fmt_range.call(best[:start], best[:end]) %></small></span></span>
      <span class="streak-progress">
        <span class="streak-progress__bar" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="<%= progress_pct %>"><span class="streak-progress__fill" style="width: <%= progress_pct %>%"></span></span>
        <span class="streak-progress__text"><%= progress_text %></span>
      </span>
    </div>
  <% end %>
</section>
