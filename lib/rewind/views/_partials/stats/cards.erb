<% cards = @stats[:cards] %>
<section class="stat-cards">
  <div class="stat-card stat-card--titles">
    <span class="stat-card__icon">◉</span>
    <span class="stat-card__value"><%= cards[:different_titles] %></span>
    <span class="stat-card__label"><%= pluralize(cards[:different_titles], "different title", count: false) %></span>
  </div>

  <div class="stat-card stat-card--rewatches">
    <span class="stat-card__icon">↻</span>
    <span class="stat-card__value"><%= cards[:rewatches] %></span>
    <span class="stat-card__label"><%= h(cards[:rewatch_label]) %></span>
  </div>

  <div class="stat-card stat-card--busiest">
    <span class="stat-card__icon">▣</span>
    <% if cards[:busiest] %>
      <span class="stat-card__value"><%= h(cards[:busiest][:label]) %></span>
      <span class="stat-card__label"><%= h(cards[:busiest][:context]) %> · <%= pluralize(cards[:busiest][:hours], "hour") %></span>
    <% else %>
      <span class="stat-card__value">—</span>
      <span class="stat-card__label">not enough data yet</span>
    <% end %>
  </div>

  <div class="stat-card stat-card--avg">
    <span class="stat-card__icon">⏱</span>
    <span class="stat-card__value"><%= cards[:average_per_week] %></span>
    <span class="stat-card__label"><%= pluralize(cards[:average_per_week], "play", count: false) %> a week, on average</span>
  </div>
</section>
