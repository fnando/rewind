<li class="integration">
  <div class="integration__head">
    <strong><%= h(source.url) %></strong>
    <span class="pill pill--<%= source.type %>"><%= h(source.type) %></span>
    <% unless source.enabled? %><span class="pill pill--muted">paused</span><% end %>
    <span class="integration__meta">Last sync: <%= source.last_synced_at ? source.last_synced_at.strftime("%Y-%m-%d %H:%M") : "never" %></span>
  </div>
  <div class="integration__row">
    <span class="integration__uid">User ID <code class="code-chip"><%= h(source.external_user_id) %></code></span>
    <div class="integration__actions">
      <form method="post" action="/settings/sources/<%= source.id %>/toggle">
        <%= csrf_tag %><button class="btn btn--ghost btn--sm" type="submit"><%= source.enabled? ? "Pause" : "Resume" %></button>
      </form>
      <form method="post" action="/settings/sources/<%= source.id %>" onsubmit="return confirm('Disconnect this source?');">
        <%= csrf_tag %>
        <input type="hidden" name="_method" value="delete">
        <button class="btn btn--ghost btn--sm" type="submit">Disconnect</button>
      </form>
    </div>
  </div>
  <% if (err = source.current_error) %>
    <div class="integration__error" role="alert">
      <span class="pill pill--danger">Sync error</span>
      <span class="integration__error-msg"><%= h(err.message) %></span>
      <span class="integration__error-time"><%= format_datetime(err.created_at) %></span>
    </div>
  <% elsif (prev = source.latest_error) %>
    <% if @show_previous_error %>
      <div class="integration__error integration__error--resolved">
        <span class="pill pill--muted">Last error (resolved)</span>
        <span class="integration__error-msg"><%= h(prev.message) %></span>
        <span class="integration__error-time"><%= format_datetime(prev.created_at) %></span>
      </div>
    <% else %>
      <div class="integration__error-prev">
        <a href="/settings?show_previous_error=true">See previous error</a>
      </div>
    <% end %>
  <% end %>
</li>
