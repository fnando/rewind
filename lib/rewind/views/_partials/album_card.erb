<%#
  A generic album cover card, shared by the History album group and the artist
  page. The caller owns the content via locals; this owns the shell.
  locals:
    album      - the album Item (poster, title link, rating target)
    detail     - optional HTML for the detail line (e.g. "artist · N tracks")
    meta       - optional text for the meta line (e.g. a play time range)
    group_key  - optional; when set, renders the expand-tracks toggle
    user_item  - optional rating for the album
%>
<%
  detail = defined?(detail) ? detail : nil
  meta = defined?(meta) ? meta : nil
  group_key = defined?(group_key) ? group_key : nil
  user_item = defined?(user_item) ? user_item : nil
%>
<li class="cover-card cover-card--track cover-card--group">
  <%= erb :"_partials/cover_poster", locals: {item: album} %>
  <span class="cover-card__scrim" aria-hidden="true"></span>

  <div class="cover-card__top">
    <span class="cover-card__badge">Album</span>
    <% if group_key %>
      <button type="button" class="cover-card__remove cover-card__album-toggle" data-album-toggle="<%= group_key %>" aria-expanded="false" aria-label="Show tracks">
        <svg class="cover-card__chevron" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
      </button>
    <% end %>
  </div>

  <div class="cover-card__body">
    <span class="cover-card__titlewrap"><a class="cover-card__title" href="/items/<%= album.id %>"><%= h(album.title) %></a></span>
    <% unless detail.to_s.empty? %>
      <span class="cover-card__detail"><%= detail %></span>
    <% end %>
    <% unless meta.to_s.empty? %>
      <span class="cover-card__meta"><%= meta %></span>
    <% end %>
    <%= rating_input(album, user_item, current_user, on_cover: true) %>
  </div>
</li>
