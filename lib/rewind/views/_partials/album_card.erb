<%
  first = plays.first
  item = first.item
  count = plays.size
  artist_item = @music_parents && @music_parents[item.metadata["artist_external_id"]]
  album_item = @music_parents && @music_parents[item.metadata["album_external_id"]]
  album_name = item.album || item.title
  times = plays.map(&:played_at).minmax
  time_label =
    if format_time(times[0]) == format_time(times[1])
      format_time(first.played_at)
    else
      "#{format_time(times[1])} – #{format_time(times[0])}"
    end
%>
<li class="play-card play-card--album">
  <img class="play-card__poster" src="<%= poster_url(item) %>" alt="">
  <div class="play-card__body">
    <% if album_item %>
      <a class="play-card__title" href="/items/<%= album_item.id %>"><%= h(album_name) %></a>
    <% else %>
      <span class="play-card__title"><%= h(album_name) %></span>
    <% end %>
    <span class="play-card__detail">
      <% if item.artist %><%= item_link(artist_item, item.artist) %> · <% end %><%= pluralize(count, "track") %>
    </span>
    <span class="play-card__meta"><%= time_label %> · <%= h(first.source.capitalize) %></span>
  </div>
  <button type="button" class="play-card__album-toggle" data-album-toggle="<%= group_key %>" aria-expanded="false" aria-label="Show tracks">
    <svg class="play-card__chevron" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
  </button>
</li>
