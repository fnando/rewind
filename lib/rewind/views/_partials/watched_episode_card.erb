<% latest = plays.first %>
<li class="play-card">
  <img class="play-card__still" src="<%= poster_url(ep, size: "w342") %>" alt="" loading="lazy" decoding="async">
  <div class="play-card__body">
    <a class="play-card__title" href="/items/<%= ep.id %>"><%= h(ep.title) %></a>
    <% if ep.release_date %><span class="play-card__detail"><%= h(format_date(ep.release_date)) %></span><% end %>
    <span class="play-card__status is-watched"><%= check_svg %>Watched <%= in_user_tz(latest.played_at).strftime("%b %-d") %> · <%= h(latest.source.capitalize) %></span>
    <% if plays.size > 1 %><span class="badge"><%= plays.size %> watches</span><% end %>
    <div class="play-card__actions">
      <%= rating_input(ep, user_item, current_user) %>
      <div class="play-card__tools">
        <form method="post" action="/history/<%= latest.id %>">
          <%= csrf_tag %>
          <input type="hidden" name="_method" value="delete">
          <button class="icon-btn" type="submit" aria-label="Remove latest watch"><%= trash_svg %></button>
        </form>
      </div>
    </div>
  </div>
</li>
