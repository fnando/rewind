<% now = in_user_tz(Time.now).strftime("%Y-%m-%dT%H:%M") %>
<form class="log-watch" method="post" action="/history">
  <%= csrf_tag %>
  <input type="hidden" name="item_id" value="<%= item.id %>">
  <label class="visually-hidden" for="played-at">When you watched it</label>
  <input class="input log-watch__when" type="datetime-local" id="played-at"
         name="played_at" value="<%= now %>" max="<%= now %>" required>
  <button class="btn btn--primary" type="submit">
    <%= plus_svg %>
    Log a watch
  </button>
</form>
