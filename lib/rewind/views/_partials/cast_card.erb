<li class="cast">
  <a class="cast__link" href="<%= tmdb_person_url(actor["id"]) %>" target="_blank" rel="noopener">
    <% if actor["profile_path"] %>
      <img class="cast__photo" src="https://image.tmdb.org/t/p/w92<%= actor["profile_path"] %>" alt="">
    <% else %>
      <span class="cast__photo" aria-hidden="true"></span>
    <% end %>
    <span class="cast__text">
      <span class="cast__name"><%= h(actor["name"]) %></span>
      <% if actor["character"] %><span class="cast__role"><%= h(actor["character"]) %></span><% end %>
    </span>
  </a>
</li>
