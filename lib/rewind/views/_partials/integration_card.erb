<li class="integration">
  <div class="integration__head">
    <strong><%= h(integration.webhook.url) %></strong>
    <span class="pill pill--<%= integration.webhook.type %>"><%= h(integration.webhook.type) %></span>
    <% if integration.disabled? %><span class="pill pill--muted">paused</span><% end %>
    <% unless integration.webhook.enabled? %><span class="pill pill--muted">server off</span><% end %>
    <span class="integration__meta">Last event: <%= integration.last_event_at ? integration.last_event_at.strftime("%Y-%m-%d %H:%M") : "never" %></span>
  </div>
  <div class="integration__row">
    <span class="integration__uid">User ID <code class="code-chip"><%= h(integration.external_user_id) %></code></span>
    <div class="integration__actions">
      <form method="post" action="/settings/integrations/<%= integration.id %>/toggle">
        <%= csrf_tag %><button class="btn btn--ghost btn--sm" type="submit"><%= integration.disabled? ? "Resume" : "Pause" %></button>
      </form>
      <form method="post" action="/settings/integrations/<%= integration.id %>" onsubmit="return confirm('Delete this integration?');">
        <%= csrf_tag %>
        <input type="hidden" name="_method" value="delete">
        <button class="btn btn--ghost btn--sm" type="submit">Delete</button>
      </form>
    </div>
  </div>
</li>
