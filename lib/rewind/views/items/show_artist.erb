<% @page_title = @item.title %>
<main class="page page--title">
  <section class="title-hero">
    <img class="title-hero__poster title-hero__poster--square"
         src="<%= poster_url(@item) %>" alt="">
    <div class="title-hero__info">
      <div class="title-hero__heading">
        <span class="eyebrow">Artist</span>
        <h1><%= h(@item.title) %></h1>
        <span class="title-meta">
          <%= pluralize(@albums.size, "album") %>
        </span>
      </div>

      <div class="hero-actions">
        <div class="hero-rating">
          <span>Your rating</span>
          <%= rating_input(@item, @user_item, current_user) %>
        </div>
      </div>
    </div>
  </section>

  <% if @albums.empty? %>
    <section class="section">
      <h2>Albums</h2>
      <p class="muted">No albums tracked for this artist yet.</p>
    </section>
  <% else %>
    <%# One section per release type when known (Albums, EPs, Singles, …),
        otherwise a single "Albums" section. %>
    <% (album_type_sections(@albums) || [["Albums", @albums]]).each do |heading, albums| %>
      <section class="section">
        <h2><%= heading %></h2>
        <%= erb :"_partials/album_grid",
                locals: {albums:, user_items: @user_items_by_item} %>
      </section>
    <% end %>
  <% end %>

  <% if @music_videos.any? %>
    <section class="section">
      <h2>Music videos</h2>
      <ul class="cover-grid">
        <% @music_videos.each do |video| %>
          <li class="cover-card cover-card--music_video">
            <%= erb :"_partials/cover_poster", locals: {item: video} %>
            <span class="cover-card__scrim" aria-hidden="true"></span>
            <div class="cover-card__top">
              <span class="cover-card__badge">Music Video</span>
            </div>
            <div class="cover-card__body">
              <span class="cover-card__titlewrap"><a class="cover-card__title" href="/items/<%= video.id %>"><%= h(video.title) %></a></span>
              <% unless video.release_date.to_s[0, 4].empty? %>
                <span class="cover-card__meta"><%= video.release_date.to_s[0, 4] %></span>
              <% end %>
            </div>
          </li>
        <% end %>
      </ul>
    </section>
  <% end %>

  <%= erb :"_partials/review", locals: {item: @item, user_item: @user_item} %>
</main>
