<% @page_title = "#{@item.metadata["series_name"]} S#{@item.season_number}E#{@item.episode_number}" %>
<main class="page page--title">
  <section class="title-hero">
    <img class="title-hero__poster" src="<%= still_url(@item.poster_path) %>" alt="">
    <div class="title-hero__info">
      <div class="title-hero__heading">
        <span class="eyebrow">Episode</span>
        <h1><%= h(@item.title) %></h1>
        <span class="title-meta">
          <% if @show %>
            <a href="/items/<%= @show.id %>"><%= h(@show.title) %></a> ·
          <% elsif @item.metadata["series_name"] %>
            <%= h(@item.metadata["series_name"]) %> ·
          <% end %>
          S<%= @item.season_number %> · E<%= @item.episode_number %>
          <% if @item.release_date %> · <%= @item.release_date[0, 4] %><% end %>
          <% rt = format_runtime(@item.runtime); if rt %> · <%= rt %><% end %>
        </span>
      </div>
      <% if @item.overview %><p class="overview"><%= h(@item.overview) %></p><% end %>

      <% if @plays.any? %>
        <div class="chips">
          <span class="chip chip--soft">Watched <%= @plays.size %> time<%= "s" unless @plays.size == 1 %></span>
          <span class="chip">Last watched <%= in_user_tz(@plays.first.played_at).strftime("%b %-d, %Y") %></span>
        </div>
      <% end %>

      <div class="hero-actions">
        <form method="post" action="/plays">
          <%= csrf_tag %>
          <input type="hidden" name="item_id" value="<%= @item.id %>">
          <button class="btn btn--primary" type="submit">
            <%= plus_svg %>
            Log a watch
          </button>
        </form>
        <div class="hero-rating">
          <span>Your rating</span>
          <%= rating_input(@item, @user_item, current_user) %>
        </div>
      </div>
    </div>
  </section>

  <%= erb :"_partials/review", locals: {item: @item, user_item: @user_item} %>

  <section class="section" aria-labelledby="watches-h">
    <h2 id="watches-h">Your watches</h2>
    <% if @plays.empty? %>
      <p class="muted">No watches logged yet.</p>
    <% else %>
      <ul class="watch-list">
        <% @plays.each do |play| %>
          <li class="watch-row">
            <div class="watch-row__when">
              <strong><time datetime="<%= play.played_at.iso8601 %>"><%= in_user_tz(play.played_at).strftime("%a, %b %-d, %Y") %></time></strong>
              <span><%= format_time(play.played_at) %> · <%= play.source == "manual" ? "Logged manually" : "via #{play.source.capitalize}" %></span>
            </div>
            <div class="watch-row__actions">
              <form method="post" action="/plays/<%= play.id %>">
                <%= csrf_tag %>
                <input type="hidden" name="_method" value="delete">
                <button class="icon-btn" type="submit" aria-label="Remove this watch"><%= trash_svg %></button>
              </form>
            </div>
          </li>
        <% end %>
      </ul>
    <% end %>
  </section>
</main>
