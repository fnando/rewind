<% @page_title = @item.title %>
<main class="page page--title">
  <section class="title-hero">
    <img class="title-hero__poster" src="<%= poster_url(@item) %>" alt="">
    <div class="title-hero__info">
      <div class="title-hero__heading">
        <span class="eyebrow">Movie</span>
        <h1><%= h(@item.title) %></h1>
        <span class="title-meta">
          <% parts = [] %>
          <% parts << @item.release_date[0, 4] if @item.release_date %>
          <% rt = format_runtime(@item.runtime); parts << rt if rt %>
          <% parts << @item.genres.join(", ") if @item.genres.any? %>
          <%= h(parts.join(" · ")) %>
        </span>
      </div>
      <% if @item.overview %><p class="overview"><%= h(@item.overview) %></p><% end %>
      <% dirs = directors(@item) %>
      <% if dirs.any? %>
        <span class="credit">Directed by <strong><%= h(dirs.join(", ")) %></strong></span>
      <% end %>

      <% if @plays.any? %>
        <div class="chips">
          <span class="chip chip--soft">Watched <%= pluralize(@plays.size, "time") %></span>
          <% if @plays.first.played_at %><span class="chip">Last watched <%= in_user_tz(@plays.first.played_at).strftime("%b %-d, %Y") %></span><% end %>
        </div>
      <% end %>

      <div class="hero-actions">
        <%= erb :"_partials/log_watch_form", locals: {item: @item} %>
        <div class="hero-rating">
          <span>Your rating</span>
          <%= rating_input(@item, @user_item, current_user) %>
        </div>
      </div>
    </div>
  </section>

  <%= erb :"_partials/review", locals: {item: @item, user_item: @user_item} %>

  <section class="section" aria-labelledby="watches-h">
    <h2 id="watches-h">Your watches</h2>
    <% if @plays.empty? %>
      <p class="muted">No watches logged yet.</p>
    <% else %>
      <ul class="watch-list">
        <% @plays.each do |play| %>
          <li class="watch-row">
            <div class="watch-row__when">
              <strong><%= play_date_html(play) %></strong>
              <span><% if play.played_at %><%= format_time(play.played_at) %> · <% end %><%= play.source == "manual" ? "Logged manually" : "via #{play.source.capitalize}" %></span>
            </div>
            <div class="watch-row__actions">
              <form method="post" action="/history/<%= play.id %>">
                <%= csrf_tag %>
                <input type="hidden" name="_method" value="delete">
                <button class="icon-btn" type="submit" aria-label="Remove this watch"><%= trash_svg %></button>
              </form>
            </div>
          </li>
        <% end %>
      </ul>
    <% end %>
  </section>

  <% cast = top_cast(@item) %>
  <% if cast.any? %>
    <section class="section" aria-labelledby="cast-h">
      <h2 id="cast-h">Top cast</h2>
      <ul class="cast-grid">
        <% cast.each do |actor| %>
          <%= erb :"_partials/cast_card", locals: {actor: actor} %>
        <% end %>
      </ul>
    </section>
  <% end %>
</main>
