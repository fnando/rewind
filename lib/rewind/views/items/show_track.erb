<% @page_title = @item.title %>
<main class="page page--title">
  <section class="title-hero">
    <img class="album-cover" src="<%= poster_url(@album || @item) %>" alt="">
    <div class="title-hero__info">
      <div class="title-hero__heading">
        <span class="eyebrow">Track</span>
        <h1><%= h(@item.title) %></h1>
        <span class="title-meta">
          <% if @artist %>
            <a href="/items/<%= @artist.id %>"><%= h(@item.artist) %></a>
          <% elsif @item.artist %>
            <%= h(@item.artist) %>
          <% end %>
          <% album_year = @album&.release_date.to_s[0, 4] %>
          <% if @album %>
            · <a href="/items/<%= @album.id %>"><%= h(@item.album) %></a><% unless album_year.empty? %> (<%= album_year %>)<% end %>
          <% elsif @item.album %>
            · <%= h(@item.album) %>
          <% end %>
          <% rt = format_runtime(@item.runtime) %>
          <% if rt %> · <%= h(rt) %><% end %>
          <% if @item.genres.any? %> · <%= h(@item.genres.join(", ")) %><% end %>
        </span>
      </div>

      <% if @plays.any? %>
        <div class="chips">
          <span class="chip chip--soft">Played <%= pluralize(@plays.size, "time") %></span>
          <% if @plays.first.played_at %><span class="chip">Last played <%= in_user_tz(@plays.first.played_at).strftime("%b %-d, %Y") %></span><% end %>
        </div>
      <% end %>

      <div class="hero-actions">
        <div class="hero-rating">
          <span>Your rating</span>
          <%= rating_input(@item, @user_item, current_user) %>
        </div>
      </div>
    </div>
  </section>

  <%= erb :"_partials/review", locals: {item: @item, user_item: @user_item} %>

  <section class="section" aria-labelledby="plays-h">
    <h2 id="plays-h">Your listens</h2>
    <% if @plays.empty? %>
      <p class="muted">No listens logged yet.</p>
    <% else %>
      <ul class="watch-list">
        <% @plays.each do |play| %>
          <li class="watch-row">
            <div class="watch-row__when">
              <strong><%= play_date_html(play) %></strong>
              <span><% if play.played_at %><%= format_time(play.played_at) %> · <% end %><%= play.source == "manual" ? "Logged manually" : "via #{play.source.capitalize}" %></span>
            </div>
            <div class="watch-row__actions">
              <form method="post" action="/history/<%= play.id %>">
                <%= csrf_tag %>
                <input type="hidden" name="_method" value="delete">
                <button class="icon-btn" type="submit" aria-label="Remove this listen"><%= trash_svg %></button>
              </form>
            </div>
          </li>
        <% end %>
      </ul>
    <% end %>
  </section>
</main>
