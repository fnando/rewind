<% @page_title = @item.title %>
<main class="page page--title">
  <section class="title-hero">
    <img class="title-hero__poster" src="<%= poster_url(@album || @item, size: "w342") %>" alt="">
    <div class="title-hero__info">
      <div class="title-hero__heading">
        <span class="eyebrow">Track</span>
        <h1><%= h(@item.title) %></h1>
        <span class="title-meta">
          <% if @artist %>
            <a href="/items/<%= @artist.id %>"><%= h(@item.artist) %></a>
          <% elsif @item.artist %>
            <%= h(@item.artist) %>
          <% end %>
          <% if @album %>
            · <a href="/items/<%= @album.id %>"><%= h(@item.album) %></a>
          <% elsif @item.album %>
            · <%= h(@item.album) %>
          <% end %>
          <% rt = format_runtime(@item.runtime) %>
          <% if rt %> · <%= h(rt) %><% end %>
          <% if @item.genres.any? %> · <%= h(@item.genres.join(", ")) %><% end %>
        </span>
      </div>

      <% if @plays.any? %>
        <div class="chips">
          <span class="chip chip--soft">Played <%= @plays.size %> time<%= "s" unless @plays.size == 1 %></span>
          <span class="chip">Last played <%= in_user_tz(@plays.first.played_at).strftime("%b %-d, %Y") %></span>
        </div>
      <% end %>

      <div class="hero-actions">
        <form method="post" action="/history">
          <%= csrf_tag %>
          <input type="hidden" name="item_id" value="<%= @item.id %>">
          <button class="btn btn--primary" type="submit">
            <%= plus_svg %>
            Log a listen
          </button>
        </form>
        <div class="hero-rating">
          <span>Your rating</span>
          <%= rating_input(@item, @user_item, current_user) %>
        </div>
      </div>
    </div>
  </section>

  <%= erb :"_partials/review", locals: {item: @item, user_item: @user_item} %>

  <section class="section" aria-labelledby="plays-h">
    <h2 id="plays-h">Your listens</h2>
    <% if @plays.empty? %>
      <p class="muted">No listens logged yet.</p>
    <% else %>
      <ul class="watch-list">
        <% @plays.each do |play| %>
          <li class="watch-row">
            <div class="watch-row__when">
              <strong><time datetime="<%= play.played_at.iso8601 %>"><%= in_user_tz(play.played_at).strftime("%a, %b %-d, %Y") %></time></strong>
              <span><%= format_time(play.played_at) %> · <%= play.source == "manual" ? "Logged manually" : "via #{play.source.capitalize}" %></span>
            </div>
            <div class="watch-row__actions">
              <form method="post" action="/history/<%= play.id %>">
                <%= csrf_tag %>
                <input type="hidden" name="_method" value="delete">
                <button class="icon-btn" type="submit" aria-label="Remove this listen"><%= trash_svg %></button>
              </form>
            </div>
          </li>
        <% end %>
      </ul>
    <% end %>
  </section>
</main>
