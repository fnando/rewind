<% @page_title = "Settings" %>
<main class="page page--wide">
  <div class="page-head">
    <h1>Settings</h1>
  </div>

  <section class="panel">
    <h2 class="panel__title">Session</h2>
    <div class="panel__body panel__body--inline">
      <p class="muted">Signed in as <strong><%= h(current_user.username) %></strong>.</p>
      <form method="post" action="/logout">
        <%= csrf_tag %>
        <button class="btn btn--secondary" type="submit">Log out</button>
      </form>
    </div>
  </section>

  <section class="panel">
    <h2 class="panel__title">Avatar</h2>
    <div class="panel__body avatar-row">
      <% url = avatar_url(current_user) %>
      <span class="avatar avatar--lg">
        <% if url %><img src="<%= url %>" alt=""><% else %><%= h(avatar_letter(current_user)) %><% end %>
      </span>
      <div class="avatar-row__actions">
        <form method="post" action="/settings/avatar" enctype="multipart/form-data">
          <%= csrf_tag %>
          <input class="file-input" id="avatar-file" type="file" name="avatar" accept="image/*" required>
          <label class="btn btn--secondary" for="avatar-file">Choose image…</label>
          <button class="btn btn--primary" type="submit">Upload</button>
        </form>
        <% if url %>
          <form method="post" action="/settings/avatar/delete">
            <%= csrf_tag %>
            <button class="btn btn--secondary" type="submit">Remove</button>
          </form>
        <% end %>
      </div>
    </div>
  </section>

  <section class="panel">
    <h2 class="panel__title">Timezone</h2>
    <form method="post" action="/settings/timezone" class="panel__body panel__body--inline">
      <%= csrf_tag %>
      <select class="input" name="timezone">
        <% TZInfo::Timezone.all_identifiers.sort.each do |tz| %>
          <option value="<%= tz %>" <%= "selected" if current_user.timezone == tz %>><%= tz %></option>
        <% end %>
      </select>
      <button class="btn btn--secondary" type="submit">Save</button>
    </form>
  </section>

  <section class="panel">
    <h2 class="panel__title">Rating style</h2>
    <form method="post" action="/settings/rating-style" class="panel__body panel__body--inline">
      <%= csrf_tag %>
      <label><input type="radio" name="rating_style" value="stars" <%= "checked" if current_user.rating_style == "stars" %>> Stars (1–5)</label>
      <label><input type="radio" name="rating_style" value="thumbs" <%= "checked" if current_user.rating_style == "thumbs" %>> Thumbs up / down</label>
      <button class="btn btn--secondary" type="submit">Save</button>
    </form>
  </section>

  <section class="panel">
    <h2 class="panel__title">Password</h2>
    <div class="panel__body">
      <p class="muted"><a href="/settings/password">Change your password →</a></p>
    </div>
  </section>

  <section class="panel">
    <h2 class="panel__title">Integrations</h2>
    <div class="panel__body">
      <% if @integrations.any? %>
        <ul class="integration-list">
          <% @integrations.each do |i| %>
            <%= erb :"_partials/integration_card", locals: {integration: i} %>
          <% end %>
        </ul>
      <% else %>
        <p class="muted">No integrations yet.</p>
      <% end %>
    </div>

    <details class="disclosure">
      <summary>Add integration</summary>
      <% if @instances.any? %>
        <form method="post" action="/settings/integrations" class="panel__body">
          <%= csrf_tag %>
          <div class="field">
            <label for="webhook_id">Jellyfin server</label>
            <select class="input" id="webhook_id" name="webhook_id">
              <option></option>

              <% @instances.each do |instance| %>
                <option value="<%= instance.id %>"><%= h(instance.url) %></option>
              <% end %>
            </select>
            <span class="field__hint">Allowlisted by your server operator.</span>
          </div>
          <div class="field" id="jf-user-picker">
            <label for="jf-user-search">Jellyfin user</label>
            <input class="input" id="jf-user-search" type="text" autocomplete="off" autocapitalize="off" autocorrect="off" spellcheck="false" data-1p-ignore data-lpignore="true" list="jf-users" placeholder="Start typing your username…" required>
            <input type="hidden" name="external_user_id" id="external_user_id">
            <datalist id="jf-users"></datalist>
            <span class="field__hint">Start typing to pick a user, or paste an ID. Users hidden from the login screen aren't listed — open your Jellyfin profile and copy the <code>userId</code> from the page URL.</span>
          </div>
          <button class="btn btn--primary" type="submit">Create integration</button>
        </form>
        <script>
          (function () {
            var picker = document.getElementById("jf-user-picker");
            if (!picker) return;
            var select = document.getElementById("webhook_id");
            var search = document.getElementById("jf-user-search");
            var hidden = document.getElementById("external_user_id");
            var list = document.getElementById("jf-users");
            var cache = {}; // webhook_id -> promise resolving to [{id, name}]

            function load(webhookId) {
              if (!cache[webhookId]) {
                cache[webhookId] = fetch(
                  "/settings/jellyfin-users?webhook_id=" + encodeURIComponent(webhookId)
                ).then(function (r) { return r.ok ? r.json() : []; })
                 .catch(function () { return []; });
              }
              return cache[webhookId];
            }

            function fill(users) {
              list.innerHTML = "";
              users.forEach(function (u) {
                var opt = document.createElement("option");
                opt.value = u.name;
                list.appendChild(opt);
              });
            }

            function resolve(users) {
              var text = search.value.trim();
              var match = users.find(function (u) {
                return u.name.toLowerCase() === text.toLowerCase();
              });
              // Fall back to the raw text so hidden/admin IDs can be pasted.
              hidden.value = match ? match.id : text;
            }

            search.addEventListener("input", function () {
              var webhookId = select.value;
              hidden.value = search.value.trim(); // keep manual IDs working
              if (!webhookId || search.value.trim().length < 2) return;

              load(webhookId).then(function (users) {
                fill(users);
                resolve(users);
              });
            });

            select.addEventListener("change", function () {
              search.value = "";
              hidden.value = "";
              fill([]);
            });
          })();
        </script>
      <% else %>
        <div class="panel__body">
          <p class="muted">No Jellyfin servers are allowlisted yet. Ask your server operator to run <code>rewind webhooks:new --url …</code>.</p>
        </div>
      <% end %>
    </details>
  </section>
</main>
