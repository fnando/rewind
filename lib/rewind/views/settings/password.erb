<% @page_title = "Change password" %>
<main class="page page--narrow">
  <div class="page-head">
    <h1>Change password</h1>
    <% if current_user.must_change_password %>
      <p>You must change your password before continuing.</p>
    <% end %>
  </div>

  <% if @error %>
    <div class="flash flash--error"><%= h(@error) %></div>
  <% end %>

  <form class="panel" method="post" action="/settings/password">
    <%= csrf_tag %>
    <div class="panel__body">
      <% unless current_user.must_change_password %>
        <div class="field">
          <label for="current_password">Current password</label>
          <input class="input" id="current_password" name="current_password" type="password" autocomplete="current-password" required>
        </div>
      <% end %>
      <div class="field">
        <label for="new_password">New password</label>
        <input class="input" id="new_password" name="new_password" type="password" autocomplete="new-password" minlength="12" required>
      </div>
      <div class="field">
        <label for="password_confirmation">Confirm</label>
        <input class="input" id="password_confirmation" name="password_confirmation" type="password" autocomplete="new-password" minlength="12" required>
      </div>
      <button class="btn btn--primary btn--block" type="submit">Change password</button>
    </div>
  </form>
</main>
