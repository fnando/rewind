<% @page_title = "Errors" %>
<main class="page page--wide">
  <div class="page-head">
    <h1>Errors</h1>
    <p class="muted"><%= pluralize(@total, "error") %> logged</p>
  </div>

  <section class="panel">
    <div class="panel__body">
      <% if @errors.empty? %>
        <p class="muted">No errors logged. Nice.</p>
      <% else %>
        <table class="error-table">
          <thead>
            <tr>
              <th>When</th>
              <th>Error</th>
              <th>Message</th>
            </tr>
          </thead>
          <tbody>
            <% @errors.each do |error| %>
              <tr>
                <td class="error-when">
                  <a href="/settings/errors/<%= error.id %>"><%= format_datetime(error.created_at) %></a>
                </td>
                <td class="error-class"><%= h(error.error_class) %></td>
                <td><a class="content-link" href="/settings/errors/<%= error.id %>"><%= h(error.message.to_s[0, 140]) %></a></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      <% end %>
    </div>
  </section>

  <% if @has_prev || @has_next %>
    <nav class="pagination" aria-label="Error pages">
      <% if @has_prev %>
        <a class="btn btn--secondary" rel="prev" href="<%= errors_page_url(@page - 1) %>">Newer</a>
      <% end %>
      <% if @has_next %>
        <a class="btn btn--secondary" rel="next" href="<%= errors_page_url(@page + 1) %>">Older</a>
      <% end %>
    </nav>
  <% end %>
</main>
