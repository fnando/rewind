<% @page_title = "Error ##{@error.id}" %>
<main class="page page--wide">
  <div class="page-head">
    <h1>Error #<%= @error.id %></h1>
    <p class="muted"><a class="content-link" href="/settings/errors">← Back to errors</a></p>
  </div>

  <section class="panel">
    <h2 class="panel__title"><%= h(@error.error_class) %></h2>
    <div class="panel__body">
      <p class="error-message"><%= h(@error.message) %></p>
      <p class="muted">Logged <%= format_datetime(@error.created_at) %></p>
    </div>
  </section>

  <% unless @error.context.empty? %>
    <section class="panel">
      <h2 class="panel__title">Data</h2>
      <div class="panel__body">
        <pre class="error-context"><%= h(JSON.pretty_generate(@error.context)) %></pre>
      </div>
    </section>
  <% end %>

  <section class="panel">
    <h2 class="panel__title">Backtrace</h2>
    <div class="panel__body">
      <% if @error.backtrace_lines.empty? %>
        <p class="muted">No backtrace captured.</p>
      <% else %>
        <pre class="error-trace"><%= h(@error.backtrace) %></pre>
      <% end %>
    </div>
  </section>
</main>
