<% @page_title = "Stats" %>
<main class="page page--wide">
  <div class="stats-controls">
    <nav class="segmented" aria-label="Period">
      <% [%w[week Last\ 7\ days], %w[month Last\ 30\ days], %w[year This\ year], %w[all All\ time]].each do |value, label| %>
        <a href="/stats?period=<%= value %>&type=<%= h(@media_type) %>"<%= ' aria-current="page"' if @period == value %>><%= label %></a>
      <% end %>
    </nav>
    <nav class="segmented" aria-label="Media type">
      <% [%w[all All], %w[movie Movies], %w[tv TV], %w[music Music]].each do |value, label| %>
        <a href="/stats?period=<%= h(@period) %>&type=<%= value %>"<%= ' aria-current="page"' if @media_type == value %>><%= label %></a>
      <% end %>
    </nav>
  </div>

  <%= erb :"_partials/stats/hero" %>
  <%= erb :"_partials/stats/cards" %>
  <%= erb :"_partials/stats/rhythm" %>
  <%= erb :"_partials/stats/heatmap" %>

  <% genres = @stats[:top_genres] %>
  <% if genres.any? %>
    <%
      hero_genre = genres.first
      total_plays = genres.sum {|g| g[:count] }
      hero_pct = total_plays.positive? ? (hero_genre[:count].to_f / total_plays * 100).round : 0
      taste_subtitle = genres.size >= 2 ? "Mostly #{genres[0][:name].downcase}, with a soft spot for #{genres[1][:name].downcase}." : nil
      genre_rows = genres[1..].to_a.map {|g| {name: g[:name], count: g[:count], count_label: pluralize(g[:count], "title"), poster_url: g[:sample] && poster_url(g[:sample], size: "w92")} }
      hero_poster = hero_genre[:sample] && poster_url(hero_genre[:sample], size: "w185")
    %>
    <%= erb :"_partials/stats/rank_list", locals: {
      title: "Your taste",
      subtitle: taste_subtitle,
      hero: {name: hero_genre[:name], meta: "#{pluralize(hero_genre[:count], "play")} · in #{hero_pct}% of everything you watched", poster_url: hero_poster},
      rows: genre_rows,
      footer_note: nil,
      variant: "taste",
      total_count: total_plays
    } %>
  <% end %>

  <% shows = @stats[:top_shows] %>
  <% if shows.any? %>
    <%
      show_external_ids = shows.map {|s| s[:parent_external_id] }.compact
      show_items = Rewind::Item.where(media_type: "tv", external_id: show_external_ids).all.each_with_object({}) {|it, h| h[it.external_id] = it }
      hero_show = shows.first
      hero_show_item = show_items[hero_show[:parent_external_id]]
      hero_poster = poster_url(hero_show_item, size: "w185") if hero_show_item
      show_rows = shows[1..].to_a.map do |row|
        it = show_items[row[:parent_external_id]]
        {
          name: row[:name],
          count: row[:episode_count],
          count_label: pluralize(row[:episode_count], "episode"),
          poster_url: it ? poster_url(it, size: "w92") : nil
        }
      end
    %>
    <%= erb :"_partials/stats/rank_list", locals: {
      title: "Shows you couldn't stop",
      subtitle: "The series you kept coming back to.",
      hero: {name: hero_show[:name], meta: pluralize(hero_show[:episode_count], "episode"), poster_url: hero_poster},
      rows: show_rows,
      footer_note: nil,
      variant: "shows",
      total_count: shows.sum {|s| s[:episode_count] }
    } %>
  <% end %>

  <%= erb :"_partials/stats/people_grid", locals: {
    title: "Familiar faces",
    subtitle: "The cast you spent the most time with.",
    people: @stats[:top_cast],
    variant: "cast"
  } %>

  <%= erb :"_partials/stats/people_grid", locals: {
    title: "Behind the camera",
    subtitle: "Directors and creators you keep coming back to.",
    people: @stats[:top_directors],
    variant: "crew"
  } %>

  <% artists = @stats[:top_artists] %>
  <% if artists.any? %>
    <%
      hero_artist = artists.first
      artist_rows = artists[1..].to_a.map {|a| {name: a[:name], count: a[:count], count_label: pluralize(a[:count], "play"), poster_url: poster_url(a[:item], size: "w185")} }
    %>
    <%= erb :"_partials/stats/rank_list", locals: {
      title: "On heavy rotation",
      subtitle: "The artists you kept coming back to.",
      hero: {name: hero_artist[:name], meta: pluralize(hero_artist[:count], "play"), poster_url: poster_url(hero_artist[:item], size: "w185")},
      rows: artist_rows,
      footer_note: nil,
      variant: "artists",
      total_count: artists.sum {|a| a[:count] }
    } %>
  <% end %>

  <% albums = @stats[:top_albums] %>
  <% if albums.any? %>
    <%
      hero_album = albums.first
      album_rows = albums[1..].to_a.map {|a| {name: a[:name], count: a[:count], count_label: pluralize(a[:count], "play"), poster_url: poster_url(a[:item], size: "w185")} }
    %>
    <%= erb :"_partials/stats/rank_list", locals: {
      title: "Albums on repeat",
      subtitle: "The records that soundtracked your days.",
      hero: {name: hero_album[:name], meta: pluralize(hero_album[:count], "play"), poster_url: poster_url(hero_album[:item], size: "w185")},
      rows: album_rows,
      footer_note: nil,
      variant: "albums",
      total_count: albums.sum {|a| a[:count] }
    } %>
  <% end %>

  <% tracks = @stats[:top_tracks] %>
  <% if tracks.any? %>
    <%
      hero_track = tracks.first
      track_rows = tracks[1..].to_a.map {|t| {name: t[:item].display_title, count: t[:count], count_label: pluralize(t[:count], "play"), poster_url: poster_url(t[:album], size: "w185")} }
    %>
    <%= erb :"_partials/stats/rank_list", locals: {
      title: "Songs you couldn't skip",
      subtitle: "The tracks you played the most.",
      hero: {name: hero_track[:item].display_title, meta: pluralize(hero_track[:count], "play"), poster_url: poster_url(hero_track[:album], size: "w185")},
      rows: track_rows,
      footer_note: nil,
      variant: "tracks",
      total_count: tracks.sum {|t| t[:count] }
    } %>
  <% end %>
</main>
