<% @page_title = "History" %>
<main class="page page--wide">
  <div class="history-head">
    <div class="history-head__left">
      <h1>History</h1>
      <nav class="segmented" aria-label="Media type">
        <a href="/history"<%= ' aria-current="page"' if @type.nil? || @type == "all" %>>All</a>
        <a href="/history?type=movie"<%= ' aria-current="page"' if @type == "movie" %>>Movies</a>
        <a href="/history?type=episode"<%= ' aria-current="page"' if @type == "episode" %>>Series</a>
        <a href="/history?type=track"<%= ' aria-current="page"' if @type == "track" %>>Music</a>
      </nav>
    </div>
    <a class="btn btn--primary" href="/search">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>
      Log a watch
    </a>
  </div>

  <% if @plays.empty? %>
    <p class="muted">No plays recorded for this filter.</p>
  <% end %>

  <% @plays_by_day.each do |day, plays| %>
    <% day_id = day ? day.iso8601 : "undated" %>
    <section class="day" aria-labelledby="day-<%= day_id %>">
      <h2 class="day__title" id="day-<%= day_id %>">
        <% if day %>
          <% label = day_label(day) %>
          <%= h(label) %>
          <span class="day__meta">
            <%# Only prefix the date when the label is relative, so we don't
                repeat "Saturday, October 17" on both lines. %>
            <% if %w[Today Yesterday].include?(label) %><%= day.strftime("%A, %B %-d") %> · <% end %><%= pluralize(plays.size, "play") %>
          </span>
        <% else %>
          Watched
          <span class="day__meta">date unknown · <%= pluralize(plays.size, "play") %></span>
        <% end %>
      </h2>
      <ul class="cover-grid">
        <% group_day_plays(plays).each do |entry| %>
          <% if entry[:type] == :album %>
            <% group_key = "group-#{entry[:plays].first.id}" %>
            <%= erb :"_partials/album_card", locals: {plays: entry[:plays], group_key: group_key} %>
            <% entry[:plays].each do |play| %>
              <%= erb :"_partials/cover_card", locals: {play: play, grouped: true, group_key: group_key} %>
            <% end %>
          <% else %>
            <%= erb :"_partials/cover_card", locals: {play: entry[:play]} %>
          <% end %>
        <% end %>
      </ul>
    </section>
  <% end %>

  <% if @has_prev || @has_next %>
    <nav class="pagination" aria-label="History pages">
      <% if @has_prev %>
        <a class="btn btn--secondary" rel="prev" href="<%= history_page_url(@page - 1) %>">Newer</a>
      <% end %>
      <% if @has_next %>
        <a class="btn btn--secondary" rel="next" href="<%= history_page_url(@page + 1) %>">Older</a>
      <% end %>
    </nav>
  <% end %>
</main>

<script>
  (function () {
    function toggle(card) {
      var key = card.getAttribute("data-album-toggle");
      var open = card.getAttribute("aria-expanded") === "true";
      card.setAttribute("aria-expanded", String(!open));
      document.querySelectorAll('[data-album-tracks="' + key + '"]')
        .forEach(function (el) { el.hidden = open; });
    }

    document.addEventListener("click", function (e) {
      var btn = e.target.closest("[data-album-toggle]");
      if (btn) { toggle(btn); }
    });
  })();
</script>
